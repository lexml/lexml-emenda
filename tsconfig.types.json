{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "incremental": false,
    "inlineSources": false,
    "outDir": "dist/types",
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "src/**/*.js", "assets/**/*.ts"],
  "exclude": ["node_modules", "dist", "out-tsc", "demo", "stories", "test"]
}
